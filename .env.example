# Copy to .env (gitignored) and fill in local-only values before running
# `docker compose up`. These are for the LOCAL TEST STACK only and are
# unrelated to the production Ansible Vault secrets.
#
# Generate values the same way as the production ones (see
# group_vars/airflow/vault.yml.example) - it's fine to reuse those
# commands here with different (throwaway, local-only) output.

POSTGRES_USER=airflow
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=airflow

REDIS_PASSWORD=CHANGE_ME_LOCAL_ONLY

# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGE_ME_LOCAL_ONLY
# python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_WEBSERVER_SECRET_KEY=CHANGE_ME_LOCAL_ONLY

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ONLY
AIRFLOW_ADMIN_EMAIL=admin@example.com
