---
# TEMPLATE - copy this file to `vault.yml` (same directory), fill in real
# values, then encrypt it in place. `vault.yml` is gitignored and must
# NEVER be committed in plaintext.
#
#   cp group_vars/airflow/vault.yml.example group_vars/airflow/vault.yml
#   $EDITOR group_vars/airflow/vault.yml   # fill in the generated secrets below
#   ansible-vault encrypt group_vars/airflow/vault.yml
#
# To edit it again later: `ansible-vault edit group_vars/airflow/vault.yml`
# To run playbooks: `ansible-playbook ... --ask-vault-pass`
#   (or configure `vault_password_file` in ansible.cfg to point at a local,
#   gitignored file containing the password, for CI/automation use)
#
# Generate each secret like this:
#
#   # Fernet key (encrypts connection passwords stored in the Airflow DB)
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
#   # Flask/webserver secret key
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
#   # DB password / Redis password (hex-only output is URI-safe, no escaping needed)
#   openssl rand -hex 24
#
#   # Admin console password (use a password manager / generator you trust)
#   openssl rand -base64 18

vault_airflow_fernet_key: "CHANGE_ME"
vault_airflow_web_secret_key: "CHANGE_ME"
vault_airflow_db_password: "CHANGE_ME"
vault_airflow_admin_password: "CHANGE_ME"
vault_airflow_admin_email: "admin@example.com"
vault_redis_password: "CHANGE_ME"
