[Unit]
Description=Airflow webserver daemon
# PostgreSQL/Redis are frequently remote (RDS/ElastiCache) so we only
# order after network-online.target, not local service units that may
# not exist on this host.
After=network-online.target
Wants=network-online.target

[Service]
RuntimeDirectory={{ airflow_app_name }}-webserver
EnvironmentFile={{ airflow_environment_file_folder }}/airflow
User={{ airflow_user }}
Group={{ airflow_group }}
Type=simple
ExecStart={{ airflow_executable }} webserver --pid {{ airflow_pidfile_folder }}-webserver/webserver.pid
KillSignal=SIGINT
Restart=on-failure
RestartSec=5s
PrivateTmp={{ airflow_private_tmp }}
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
